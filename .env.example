# Copy to .env (gitignored) and fill in — same project as your Python app's
# secrets.toml [supabase] section. This is the PUBLIC anon key — safe to
# ship in browser code, since RLS (see 01_supabase_schema.sql) is what
# actually enforces access control, not secrecy of this key.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
